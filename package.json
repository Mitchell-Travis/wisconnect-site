{
  "name": "wisconnect-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": ".venv/bin/python -m uvicorn backend.app.main:app --reload --port 8001",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": ".venv/bin/python -m alembic -c backend/alembic.ini upgrade head",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}

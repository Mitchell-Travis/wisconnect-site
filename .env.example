DATABASE_URL=postgresql+psycopg://wisconnect:wisconnect@127.0.0.1:5432/wisconnect
# npm run dev:api enables this flag and binds the API to loopback.
# This authentication pilot intentionally supports only http://localhost:3000.
WISCONNECT_LOCAL_AUTH=1

# Contact notifications default to local Mailpit; no external email is sent.
WISCONNECT_CONTACT_MAIL_MODE=local
# For real notifications, set mode=smtp and configure a verified sender.
# These must be server environment variables; never NEXT_PUBLIC_* values.
# The contact recipient is fixed to hello@wisconnect.co.
# WISCONNECT_CONTACT_SMTP_HOST=smtp.your-provider.example
# WISCONNECT_CONTACT_SMTP_PORT=587
# WISCONNECT_CONTACT_SMTP_SECURITY=starttls
# WISCONNECT_CONTACT_SMTP_USER=
# WISCONNECT_CONTACT_SMTP_PASSWORD=
# WISCONNECT_CONTACT_FROM=WisConnect <verified-sender@wisconnect.co>
